# Entorno
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=condominios_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/condominios_db

# Seguridad JWT
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_example
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_characters_example
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200,http://localhost:3000

# Almacenamiento (local | s3 | r2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BASE_URL=http://localhost:3000/uploads

# Cloudflare R2 / S3 (Opcional para producción)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=condominios-storage
R2_ENDPOINT=

# Firebase Cloud Messaging (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
